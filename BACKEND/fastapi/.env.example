APP_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/ride_app?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEOCODER_USER_AGENT=RideAppDemo/1.0 (replace-with-your-contact-email)
RIDE_MATCH_RADIUS_KM=10
# Optional Firebase Cloud Messaging delivery. Keep service-account JSON outside Git.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional dynamic USD KHQR payment. Use your own verified merchant details and NBC token.
# Registered merchant receiving account used for KHQR settlement (configure with the bank)
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_PHONE_NUMBER=
BAKONG_API_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_QR_EXPIRY_MINUTES=5
