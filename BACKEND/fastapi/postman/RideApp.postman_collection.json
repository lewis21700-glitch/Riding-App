{
  "info": {
    "name": "RideApp API",
    "description": "Core requests for the six RideApp development sprints. Configure baseUrl, then register or log in with rider, driver, and admin accounts. Provider-dependent Firebase and Bakong calls require credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "riderEmail", "value": "postman-rider@example.com" },
    { "key": "riderPassword", "value": "Postman-Rider-123!" },
    { "key": "driverEmail", "value": "postman-driver@example.com" },
    { "key": "driverPassword", "value": "Postman-Driver-123!" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "riderToken", "value": "" },
    { "key": "driverToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "riderId", "value": "" },
    { "key": "driverId", "value": "" },
    { "key": "rideId", "value": "" },
    { "key": "khqrRideId", "value": "" },
    { "key": "intentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health and authentication",
      "item": [
        { "name": "Health check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        {
          "name": "Register rider",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('riderToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('riderId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Rider\",\n  \"email\": \"{{riderEmail}}\",\n  \"phone\": \"0123456789\",\n  \"password\": \"{{riderPassword}}\",\n  \"role\": \"rider\"\n}" }, "url": "{{baseUrl}}/api/register" }
        },
        {
          "name": "Login rider",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('riderToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('riderId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{riderEmail}}\",\n  \"password\": \"{{riderPassword}}\"\n}" }, "url": "{{baseUrl}}/api/login" }
        },
        { "name": "Get my profile", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/profile" } },
        { "name": "Update my profile", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Rider Updated\",\n  \"phone\": \"0123456789\"\n}" }, "url": "{{baseUrl}}/api/profile" } }
      ]
    },
    {
      "name": "Driver onboarding and availability",
      "item": [
        {
          "name": "Register driver",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('driverToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('driverId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Driver\",\n  \"email\": \"{{driverEmail}}\",\n  \"phone\": \"0123456788\",\n  \"password\": \"{{driverPassword}}\",\n  \"role\": \"driver\"\n}" }, "url": "{{baseUrl}}/api/register" }
        },
        { "name": "Register or update my vehicle", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"vehicle_type\": \"Car\",\n  \"vehicle_model\": \"Postman Test Car\",\n  \"plate_number\": \"PM-{{$timestamp}}\"\n}" }, "url": "{{baseUrl}}/api/my-vehicle" } },
        { "name": "Go online", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"availability\": \"online\"\n}" }, "url": "{{baseUrl}}/api/drivers/{{driverId}}/availability" } },
        { "name": "Share online location for nearby matching", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"latitude\": 11.5564,\n  \"longitude\": 104.9282\n}" }, "url": "{{baseUrl}}/api/driver-location" } },
        { "name": "Get my vehicle", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/my-vehicle" } }
      ]
    },
    {
      "name": "Booking and matching",
      "item": [
        { "name": "Estimate fare", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ride_type\": \"Car\",\n  \"pickup_lat\": 11.5564,\n  \"pickup_lng\": 104.9282,\n  \"destination_lat\": 11.5664,\n  \"destination_lng\": 104.9382\n}" }, "url": "{{baseUrl}}/api/fare/estimate" } },
        {
          "name": "Request ride",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.ride_id) pm.collectionVariables.set('rideId', data.ride_id);"] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"pickup_location\": \"Phnom Penh\",\n  \"destination\": \"Central Market\",\n  \"ride_type\": \"Car\",\n  \"pickup_lat\": 11.5564,\n  \"pickup_lng\": 104.9282,\n  \"destination_lat\": 11.5664,\n  \"destination_lng\": 104.9382\n}" }, "url": "{{baseUrl}}/api/rides" }
        },
        { "name": "Driver ride offers", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/driver-rides" } },
        { "name": "Accept ride", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"accepted\"\n}" }, "url": "{{baseUrl}}/api/driver-rides/{{rideId}}" } }
      ]
    },
    {
      "name": "Trip tracking and completion",
      "item": [
        { "name": "Start trip", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ongoing\"\n}" }, "url": "{{baseUrl}}/api/driver-rides/{{rideId}}" } },
        { "name": "Share location during trip", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"latitude\": 11.5564,\n  \"longitude\": 104.9282,\n  \"heading\": 90\n}" }, "url": "{{baseUrl}}/api/driver-location?ride_id={{rideId}}" } },
        { "name": "Track my ride", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/rides/{{rideId}}/track" } },
        { "name": "Complete trip", "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driverToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }, "url": "{{baseUrl}}/api/driver-rides/{{rideId}}" } }
      ]
    },
    {
      "name": "Payment and ratings",
      "item": [
        { "name": "Record cash payment", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ride_id\": {{rideId}},\n  \"payment_method\": \"cash\"\n}" }, "url": "{{baseUrl}}/api/payments" } },
        { "name": "View receipt", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/rides/{{rideId}}/receipt" } },
        { "name": "Rate completed ride", "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ride_id\": {{rideId}},\n  \"score\": 5,\n  \"comment\": \"Postman test ride\"\n}" }, "url": "{{baseUrl}}/api/ratings" } },
        { "name": "Create KHQR intent (requires Bakong configuration and an unpaid completed ride)", "description": "Set khqrRideId to a different completed, unpaid ride. The cash-payment request above already pays rideId.", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.intent_id) pm.collectionVariables.set('intentId', data.intent_id);"] } }], "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ride_id\": {{khqrRideId}}\n}" }, "url": "{{baseUrl}}/api/payments/khqr" } },
        { "name": "Check KHQR payment (requires Bakong configuration)", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/payments/khqr/{{intentId}}" } }
      ]
    },
    {
      "name": "Admin operations",
      "item": [
        { "name": "Admin login", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('adminToken', data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/login" } },
        { "name": "List users", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/users" } },
        { "name": "List drivers", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/drivers" } },
        { "name": "List rides", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/rides" } },
        { "name": "List payments", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/payments" } },
        { "name": "List ratings", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/ratings" } },
        { "name": "List notifications", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/notifications" } }
      ]
    }
  ]
}
